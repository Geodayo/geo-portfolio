# Required for /api/chat. Create at https://vercel.com/<team>/~/ai/api-keys (AI Gateway API Keys).
AI_GATEWAY_API_KEY=

# Optional. Defaults to "anthropic/claude-haiku-4.5". Any model slug listed at
# https://ai-gateway.vercel.sh/v1/models works (creator/model-name format).
AI_GATEWAY_MODEL=

# Required for /api/contact (the #contact-me form). Create at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Where contact form submissions get delivered. Defaults to Jorge's address.
CONTACT_TO_EMAIL=

# Optional. Sender Resend uses. Defaults to "Portfolio Contact <onboarding@resend.dev>",
# which needs no domain verification but only delivers to the Resend account owner's inbox.
CONTACT_FROM_EMAIL=
